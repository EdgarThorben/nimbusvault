DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# AES-256 key for encrypting credential secrets, base64-encoded 32 bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# Optional: enables AI-assisted field normalization and duplicate detection
# on the item create/edit forms. Unset simply hides that panel.
ANTHROPIC_API_KEY=

# HMAC-SHA256 shared secret for the /api/ingest webhook receiver.
# Unset disables the endpoint (it answers 503). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_WEBHOOK_SECRET=
