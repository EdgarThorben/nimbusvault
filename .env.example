DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Private Vercel Blob store for job photos.
BLOB_READ_WRITE_TOKEN=

# Used once by `npm run db:seed` to create Leo's login.
LEO_EMAIL=
LEO_PASSWORD=

# 1 = show the passwordless "Enter the prototype" button. Off for real use.
DEMO_MODE=
