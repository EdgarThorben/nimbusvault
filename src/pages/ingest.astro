---
import BookStackLayout from "../layouts/BookStackLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Badge from "../components/Badge.astro";
import { actions } from "astro:actions";
import { listIngestEvents } from "../lib/ingestQueries";
import { isIngestConfigured } from "../lib/ingestAuth";
import { formatRelativeTime } from "../lib/time";
import { t, tItemType } from "../lib/i18n";

const lang = Astro.locals.lang;

if (!Astro.locals.user) {
  return Astro.redirect("/login");
}

const applyResult = Astro.getActionResult(actions.applyIngestEvent);
const rejectResult = Astro.getActionResult(actions.rejectIngestEvent);
if ((applyResult && !applyResult.error) || (rejectResult && !rejectResult.error)) {
  return Astro.redirect("/ingest");
}

const events = await listIngestEvents();
const configured = isIngestConfigured();

const statusTone = {
  pending: "warning",
  applied: "success",
  rejected: "danger",
} as const;
const statusLabel = {
  pending: t(lang, "ingest.statusPending"),
  applied: t(lang, "ingest.statusApplied"),
  rejected: t(lang, "ingest.statusRejected"),
};

const breadcrumbItems = [
  { label: t(lang, "nav.home"), href: "/", icon: "shelf" },
  { label: t(lang, "ingest.title"), href: "", icon: "book", current: true },
];
---

<BookStackLayout title="Ingest inbox">
  <Breadcrumb items={breadcrumbItems} />
  <div class="home-wrap">
    <h1>{t(lang, "ingest.title")}</h1>
    <p style="color:var(--muted);">{t(lang, "ingest.tagline")}</p>

    {
      !configured && (
        <div class="warning-box">
          <span class="warn-icon">&#9888;</span>
          <div>{t(lang, "ingest.notConfigured")}</div>
        </div>
      )
    }

    <p class="normalize-hint">
      {t(lang, "ingest.endpointHint")} <code>POST /api/ingest</code>
    </p>

    {(applyResult?.error || rejectResult?.error) && (
      <p class="login-error">{applyResult?.error?.message ?? rejectResult?.error?.message}</p>
    )}

    {events.length === 0 && <p class="no-changes">{t(lang, "ingest.none")}</p>}

    <ul class="ingest-list">
      {
        events.map((event) => (
          <li class={`ingest-event ingest-event--${event.status}`}>
            <div class="ingest-head">
              <Badge tone={statusTone[event.status]}>{statusLabel[event.status]}</Badge>
              <strong>{event.payload.name}</strong>
              <span class="ingest-meta">
                {tItemType(lang, event.payload.type)} · {t(lang, "ingest.source")}: {event.source} ·
                {" "}{t(lang, "ingest.received")} {formatRelativeTime(event.receivedAt, lang)}
              </span>
            </div>

            <div class="ingest-body">
              <span class="ingest-meta">
                {t(lang, "ingest.proposes")}: {event.payload.fields.length} {t(lang, "ingest.fields")}
                {" → "}/collections/{event.payload.collectionSlug}
              </span>
              {event.payload.fields.length > 0 && (
                <div class="table-scroll">
                  <table class="detail-table">
                    <tbody>
                      {event.payload.fields.map((f) => (
                        <tr>
                          <th>{f.label}</th>
                          <td>{f.value}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>

            {
              event.status === "pending" ? (
                <div class="ingest-actions">
                  <form method="POST" action={actions.applyIngestEvent}>
                    <input type="hidden" name="id" value={event.id} />
                    <button type="submit" class="primary-button">{t(lang, "ingest.apply")}</button>
                  </form>
                  <form method="POST" action={actions.rejectIngestEvent} class="ingest-reject-form">
                    <input type="hidden" name="id" value={event.id} />
                    <input type="text" name="note" placeholder={t(lang, "ingest.rejectNote")} />
                    <button type="submit" class="secondary-button">{t(lang, "ingest.reject")}</button>
                  </form>
                </div>
              ) : (
                <div class="ingest-meta">
                  {t(lang, "ingest.reviewedBy")} {event.reviewerName ?? t(lang, "common.unknown")}
                  {event.reviewedAt && <> · {formatRelativeTime(event.reviewedAt, lang)}</>}
                  {event.itemSlug && (
                    <>
                      {" · "}{t(lang, "ingest.recordedAs")}{" "}
                      <a href={`/items/${event.itemSlug}`}>{event.itemName}</a>
                    </>
                  )}
                  {event.note && <> · “{event.note}”</>}
                </div>
              )
            }
          </li>
        ))
      }
    </ul>
  </div>
</BookStackLayout>
