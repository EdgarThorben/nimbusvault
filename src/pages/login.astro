---
import AppLayout from "../layouts/AppLayout.astro";
import { actions } from "astro:actions";
import { business } from "../config";

const result = Astro.getActionResult(actions.login);
if (Astro.locals.user || (result && !result.error)) {
  return Astro.redirect("/jobs");
}
---

<AppLayout title="Log in">
  <main class="login">
    <div style="display:flex;flex-direction:column;gap:4px;">
      <span class="eyebrow">{business.name}</span>
      <h1>Log in</h1>
    </div>
    {result?.error && <p class="error">{result.error.message}</p>}
    <form class="form" method="POST" action={actions.login}>
      <label class="field">
        Email
        <input type="email" name="email" autocomplete="username" required />
      </label>
      <label class="field">
        Password
        <input type="password" name="password" autocomplete="current-password" required />
      </label>
      <button type="submit" class="btn btn-primary">Log in</button>
    </form>
  </main>
</AppLayout>
