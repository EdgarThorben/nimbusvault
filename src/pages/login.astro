---
import AppLayout from "../layouts/AppLayout.astro";
import { actions } from "astro:actions";
import { business, DEMO_LOGIN, DEMO_MODE } from "../config";

const result = Astro.getActionResult(actions.login) ?? Astro.getActionResult(actions.demoLogin);
if (Astro.locals.user || (result && !result.error)) {
  return Astro.redirect("/jobs");
}
---

<AppLayout title="Log in">
  <main class="login">
    <div style="display:flex;flex-direction:column;gap:4px;">
      <span class="eyebrow">{business.name}</span>
      <h1>Log in</h1>
    </div>
    {result?.error && <p class="error">{result.error.message}</p>}
    {
      DEMO_MODE && (
        <form method="POST" action={actions.demoLogin} style="display:flex;flex-direction:column;gap:8px;">
          <button type="submit" class="btn btn-primary">Enter the prototype</button>
          <span class="muted small" style="text-align:center;">Prototype with example data. No password needed.</span>
        </form>
      )
    }
    <form class="form" method="POST" action={actions.login}>
      <label class="field">
        Email
        <input type="email" name="email" autocomplete="username" required value={DEMO_MODE ? DEMO_LOGIN.email : undefined} />
      </label>
      <label class="field">
        Password
        <input type="password" name="password" autocomplete="current-password" required value={DEMO_MODE ? DEMO_LOGIN.password : undefined} />
      </label>
      <button type="submit" class:list={["btn", { "btn-primary": !DEMO_MODE }]}>Log in</button>
    </form>
  </main>
</AppLayout>
