---
import { MAX_IMPACT_DEPTH, type ImpactNode } from "../lib/itemGraph";
import { t, tItemType, tRelationshipType } from "../lib/i18n";

interface Props {
  dependents: ImpactNode[];
  dependencies: ImpactNode[];
  truncated: boolean;
}

const { dependents, dependencies, truncated } = Astro.props;
const lang = Astro.locals.lang;

// Depth 1 is a direct edge; anything further was only reached through another
// item, which is exactly the distinction an on-call engineer cares about.
const directCount = (nodes: ImpactNode[]) => nodes.filter((n) => n.depth === 1).length;
---

<h2 id="impact">{t(lang, "item.impact")}</h2>

<div class="impact-grid">
  <section class="impact-col">
    <h3>
      {t(lang, "item.impactBlast")}
      <span class={`impact-count ${dependents.length > 0 ? "impact-count--danger" : ""}`}>
        {dependents.length} {t(lang, "item.impactAffected")}
      </span>
    </h3>
    {dependents.length === 0 && <p class="no-changes">{t(lang, "item.impactNoDependents")}</p>}
    {
      dependents.length > 0 && (
        <p class="impact-summary">
          {directCount(dependents)} {t(lang, "item.impactDirect")} ·
          {" "}{dependents.length - directCount(dependents)} {t(lang, "item.impactIndirect")}
        </p>
      )
    }
    <ul class="impact-list">
      {
        dependents.map((n) => (
          <li style={`--impact-depth:${n.depth - 1}`}>
            <span class="impact-ring" data-depth={n.depth} />
            <a href={`/items/${n.slug}`}>{n.name}</a>
            <span class="impact-meta">
              {tItemType(lang, n.type)} · {tRelationshipType(lang, n.relationshipType)}
              {n.via && <> · {t(lang, "item.impactVia")} {n.via}</>}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="impact-col">
    <h3>
      {t(lang, "item.impactDepends")}
      <span class="impact-count">{dependencies.length} {t(lang, "item.impactRequired")}</span>
    </h3>
    {dependencies.length === 0 && <p class="no-changes">{t(lang, "item.impactNoDependencies")}</p>}
    <ul class="impact-list">
      {
        dependencies.map((n) => (
          <li style={`--impact-depth:${n.depth - 1}`}>
            <span class="impact-ring" data-depth={n.depth} />
            <a href={`/items/${n.slug}`}>{n.name}</a>
            <span class="impact-meta">
              {tItemType(lang, n.type)} · {tRelationshipType(lang, n.relationshipType)}
              {n.via && <> · {t(lang, "item.impactVia")} {n.via}</>}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</div>

{
  truncated && (
    <p class="no-changes">
      {t(lang, "item.impactTruncated")} ({MAX_IMPACT_DEPTH})
    </p>
  )
}
